# Supabase → Project Settings → API. Both are safe to expose to the browser
# (that's what "publishable/anon" means) — RLS policies in db/schema.sql define
# what they can actually read/write.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — server-only (NOT prefixed with NEXT_PUBLIC_, never sent to the
# browser). Enables the "My Story" attempt-history view by letting the API read
# a session's own submissions server-side. Leave unset and history degrades to
# local (per-browser) stats only. Supabase → Project Settings → API → service_role.
# Treat this like a password: set it in Vercel env vars, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
