# Supabase → Project Settings → API. Both are safe to expose to the browser
# (that's what "publishable/anon" means) — RLS policies in db/schema.sql define
# what they can actually read/write.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx